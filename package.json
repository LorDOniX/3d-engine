{
  "name": "3d-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Own ray caster engine in TypeScript using 2d canvas",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "npm run typecheck && npm run lint && npm test && webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "ISC",
  "devDependencies": {
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "oxlint": "^1.89.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": false
  }
}
